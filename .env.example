# Copy to .env and adjust. Real environment variables take precedence over .env.
HTTP_ADDR=:8080
DATABASE_URL=postgres://sitewatch:sitewatch@localhost:5432/sitewatch?sslmode=disable

# Worker pool size: how many sites are checked concurrently.
WORKERS=5
# Timeout of a single HTTP probe.
CHECK_TIMEOUT=5s
# Timeout of a whole check run (all sites).
RUN_TIMEOUT=30s
# Background check interval; 0 disables the scheduler.
CHECK_INTERVAL=1m
SHUTDOWN_TIMEOUT=10s
